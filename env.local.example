# Copy to .env.local (`cp env.local.example .env.local`) and fill in, then
# restart (`npm run dev`) or rebuild (`npm run build`). NEXT_PUBLIC_* vars are
# inlined at build time, so changing one needs a rebuild, not just a restart.
#
# The app runs without any of this — each unset group degrades to a visible,
# self-describing state rather than an error page.

# --- cluster ---------------------------------------------------------------
# Base URL of the ThoughtSpot instance. Read on both sides (the server mints
# tokens with it, the browser points the SDK at it), so it is NEXT_PUBLIC_.
# Not a secret.
NEXT_PUBLIC_TS_HOST=
NEXT_PUBLIC_TAB_ID_BALANCES=925f639f-de66-4d76-8beb-2a502b67d300

# Tab GUIDs within that liveboard (not display names). A tab with no GUID
# still renders its button; clicking it just won't switch the board.
NEXT_PUBLIC_TAB_ID_OVERVIEW=826cf5d2-0e8e-4a3b-9ada-e3f2b0d28a37
NEXT_PUBLIC_TAB_ID_CUSTOMER=20483005-5691-4def-8a1f-f635944bf529
NEXT_PUBLIC_TAB_ID_PRODUCT=98e6afef-f88b-45ac-aa38-09319c70dec5

# GUID of the data model Marginal is locked to. It cannot reach anything else
# — this is enforced in code, not just in the prompt.
NEXT_PUBLIC_SPOTTER_MODEL_ID=e6158c2b-4723-444d-b562-046b091c2fc5

# --- /analytics: one liveboard, three native tabs --------------------------
# A single liveboard is embedded and tab switches go through
# HostEvent.SetActiveTab, so the iframe never remounts and filter state
# survives a tab change.
NEXT_PUBLIC_LIVEBOARD_ID=a417dd40-6df1-480d-8369-84debc4a4ce9

# Trusted-auth secret key: Develop > Customizations > Security.
# SERVER ONLY — never prefix this with NEXT_PUBLIC_.
TS_SECRET_KEY=

# Numeric org id. Required on multi-org clusters; omit on single-org.
TS_ORG_ID=0

# --- Marginal (the AI assistant on /home) ----------------------------------
# Marginal is Claude orchestrating ThoughtSpot's Spotter MCP server, so it
# needs an Anthropic key. Without it the chat opens and says so.
ANTHROPIC_API_KEY=

# --- branding (swap these to repoint the app at another prospect) ----------
NEXT_PUBLIC_BRAND_NAME=LedgerWise
NEXT_PUBLIC_SPOTTER_PERSONA_NAME=Marginal

