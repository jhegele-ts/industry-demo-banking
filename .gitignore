# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Salesforce CLI local cache — unrelated to this project, machine-specific
.sf/

# Local env copies holding real values. `.env*` above misses anything that
# does not start with a dot -- e.g. "env.local copy.example", which is how a
# duplicated template ends up carrying a real cluster host into a commit.
# The only env file meant to be tracked is the placeholder template.
env*.local
env.local*.example
!env.local.example

# Demo recordings and their transcripts. Reference material dropped in the
# repo root while working on the demo story — useful locally, not part of the
# app, and not ours to redistribute.
*.srt
*.vtt

# Scratch copies of the embed theme, for iterating without the push/purge
# cycle. The real one lives in jhegele-ts/industry-demos-assets; a tracked
# copy here is what caused it to drift twice.
public/embed/

# Editor and OS cruft that tends to appear later.
.vscode/
.idea/
*.swp

# Browser-check artifacts, if anyone drives the app with Playwright.
/playwright-report/
/test-results/

# Reference material dropped in the repo root while building: other demos'
# files, source images for icons, downloaded archives. Useful on the machine
# you are working on, not part of the app.
financeReadme.md
quill.png
*.zip

# Internal demo material. Useful on the machine you build on, not part of the
# app and not for the repo: the SE one-pager (what to say, what not to
# promise), the liveboard's exported TML (carries the demo-script tile), and
# a screenshot.
LedgerWise-one-pager.md
Banking_Liveboard.yaml
LedgerWiseAnalytics.png
